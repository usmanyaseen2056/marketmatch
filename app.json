{
  "expo": {
    "name": "MarketMatch",
    "slug": "marketmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marketmatch.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.marketmatch.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "MarketMatch uses the camera to take live photos of phones and scan shop QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MarketMatch uses the camera to take live photos of phones for offers."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B0B0B"
        }
      ]
    ],
    "scheme": "marketmatch",
    "experiments": {
      "typedRoutes": false
    }
  }
}
